    {
      "id": "e83f219a-7b12-4408-922d-1ac629658001",
      "title": "镜中倒影",
      "content": "站在老旧浴室镜子前，镜里的我动作慢半拍。我抬手，倒影却没有跟随，它缓缓抬起头，嘴角扯出诡异的笑容。我向后退，镜子里的身影一步步从镜面向外爬出，四周瓷砖开始渗出发黑的水渍。",
      "user_mood": null,
      "ai_mood": "fear",
      "mood_score": 10,
      "emotions": "{\"calm\":5,\"joy\":0,\"fear\":94,\"sadness\":30}",
      "tags": "[\"镜子\", \"诡异\"]",
      "lucidity": 1,
      "dream_date": "2026-07-06",
